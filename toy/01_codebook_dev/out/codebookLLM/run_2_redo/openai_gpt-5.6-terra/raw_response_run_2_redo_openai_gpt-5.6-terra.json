      "content": "{\"classifications\":{\"42\":\"1\",\"50\":\"0\",\"57\":\"1\",\"89\":\"1\",\"133\":\"0\",\"157\":\"0\",\"189\":\"1\",\"214\":\"0\",\"240\":\"0\",\"299\":\"0\",\"453\":\"0\",\"490\":\"0\",\"597\":\"0\",\"630\":\"0\",\"656\":\"0\",\"714\":\"1\",\"721\":\"0\",\"744\":\"0\",\"773\":\"1\",\"794\":\"1\",\"805\":\"0\",\"817\":\"1\",\"871\":\"0\",\"873\":\"1\",\"918\":\"0\",\"964\":\"0\",\"967\":\"0\",\"1021\":\"0\",\"1043\":\"1\",\"1060\":\"1\",\"1086\":\"0\",\"1118\":\"0\",\"1139\":\"0\",\"1155\":\"1\",\"1177\":\"0\",\"1230\":\"1\",\"1257\":\"1\",\"1313\":\"0\",\"1320\":\"1\",\"1325\":\"0\",\"1610\":\"0\",\"1736\":\"0\",\"1747\":\"1\",\"1749\":\"1\",\"1827\":\"1\",\"1862\":\"1\",\"1897\":\"0\",\"1927\":\"1\",\"1957\":\"0\",\"2003\":\"0\",\"2026\":\"1\",\"2143\":\"0\",\"2318\":\"1\",\"2335\":\"1\",\"2368\":\"1\",\"2382\":\"1\",\"2627\":\"1\",\"2675\":\"0\",\"2697\":\"1\",\"2807\":\"0\",\"2827\":\"0\",\"2869\":\"0\",\"2895\":\"1\",\"3038\":\"0\",\"3047\":\"1\",\"3143\":\"1\",\"3149\":\"1\",\"3201\":\"1\",\"3252\":\"1\",\"3271\":\"1\",\"3477\":\"0\",\"3482\":\"1\",\"3501\":\"0\",\"3534\":\"0\",\"3560\":\"0\",\"3577\":\"0\",\"3659\":\"0\",\"3687\":\"0\",\"3729\":\"1\",\"3744\":\"1\",\"3817\":\"1\",\"3845\":\"1\",\"3914\":\"0\",\"3950\":\"1\",\"4022\":\"1\",\"4122\":\"1\",\"4124\":\"0\",\"4184\":\"1\",\"4207\":\"0\",\"4208\":\"1\",\"4295\":\"1\",\"4328\":\"1\",\"4344\":\"1\",\"4403\":\"1\",\"4508\":\"1\",\"4531\":\"1\",\"4585\":\"1\",\"4677\":\"1\",\"4771\":\"1\",\"4774\":\"1\"},\"codebook\":{\"definition\":\"Credit-claiming occurs when a senator presents themself as having caused, secured, authored, advanced, protected, or otherwise materially contributed to a government action, policy, program, funding award, or benefit.\",\"clarification\":\"Classify a release as credit-claiming when it explicitly attributes a concrete accomplishment or beneficial result to the senator's own actions, such as introducing or authoring legislation, securing appropriations or grants, obtaining an agency decision, winning an amendment, or successfully advocating for a local institution or constituency. Credit-claiming also includes statements tying a favorable outcome to prior work by the senator, including language such as “helped secure,” “authored,” “my request,” “worked to expedite,” or “responded to my concerns.”\",\"positive_examples\":[{\"text\":\"Sen. Talent announced that the Senate has approved his request for $1.5 million dollars for the Health Sciences Research and Education Facility at the University of Missouri-Columbia.\",\"explanation\":\"This explicitly credits Talent's personal request with obtaining a specific appropriation for a Missouri institution.\"},{\"text\":\"Dorgan authored legislation, which was signed into law, that created the National Center designation.\",\"explanation\":\"Dorgan directly claims authorship of the enacted law that produced the designation for Bismarck State College.\"},{\"text\":\"Senator Clinton... played a key role... in preventing the removal of four C-130 Aircraft... from the Stratton Air National Guard base.\",\"explanation\":\"The release expressly attributes a beneficial outcome for a New York military installation to Clinton's role.\"}],\"negative_clarification\":\"Do not classify a release as credit-claiming when it merely states a policy position, criticizes another official or administration, commemorates an event or person, announces an agency action without connecting it to the senator's work, or describes future intentions to advocate. Membership on a committee, attendance at a meeting, or generic support for a program is not sufficient on its own.\",\"negative_examples\":[{\"text\":\"The Bush Administration's 'head in the sand' position on global warming has defied reason and common sense.\",\"explanation\":\"This is criticism of the administration's policy, not a claim that Senator Reid delivered a policy achievement or constituent benefit.\"},{\"text\":\"U.S. Senator Jeff Bingaman today announced that New Mexico State University has been awarded $599,691 to help improve food safety.\",\"explanation\":\"Although the senator announces a grant, the text does not say that he secured, requested, or influenced the award.\"},{\"text\":\"I will continue to fight for Malmstrom and the Air Force in the United States Senate and I will work toward getting another mission at the base.\",\"explanation\":\"This is a promise of future advocacy after an unfavorable decision, rather than a claim of an accomplishment already delivered.\"}]}}",
