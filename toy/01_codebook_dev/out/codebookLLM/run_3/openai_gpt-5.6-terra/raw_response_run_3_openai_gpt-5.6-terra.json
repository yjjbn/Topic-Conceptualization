      "content": "{\"classifications\":{\"42\":\"1\",\"50\":\"0\",\"57\":\"0\",\"89\":\"1\",\"133\":\"0\",\"157\":\"0\",\"189\":\"0\",\"214\":\"0\",\"240\":\"0\",\"299\":\"0\",\"453\":\"0\",\"490\":\"0\",\"597\":\"0\",\"630\":\"0\",\"656\":\"0\",\"714\":\"1\",\"721\":\"0\",\"744\":\"0\",\"773\":\"1\",\"794\":\"1\",\"805\":\"0\",\"817\":\"0\",\"871\":\"0\",\"873\":\"1\",\"918\":\"0\",\"964\":\"0\",\"967\":\"0\",\"1021\":\"0\",\"1043\":\"1\",\"1060\":\"0\",\"1086\":\"0\",\"1118\":\"0\",\"1139\":\"0\",\"1155\":\"1\",\"1177\":\"0\",\"1230\":\"1\",\"1257\":\"1\",\"1313\":\"0\",\"1320\":\"1\",\"1325\":\"0\",\"1610\":\"0\",\"1736\":\"0\",\"1747\":\"1\",\"1749\":\"0\",\"1827\":\"1\",\"1862\":\"1\",\"1897\":\"0\",\"1927\":\"1\",\"1957\":\"0\",\"2003\":\"0\",\"2026\":\"1\",\"2143\":\"0\",\"2318\":\"1\",\"2335\":\"1\",\"2368\":\"1\",\"2382\":\"1\",\"2627\":\"1\",\"2675\":\"0\",\"2697\":\"1\",\"2807\":\"0\",\"2827\":\"0\",\"2869\":\"0\",\"2895\":\"1\",\"3038\":\"0\",\"3047\":\"1\",\"3143\":\"1\",\"3149\":\"0\",\"3201\":\"1\",\"3252\":\"1\",\"3271\":\"1\",\"3477\":\"0\",\"3482\":\"1\",\"3501\":\"0\",\"3534\":\"0\",\"3560\":\"0\",\"3577\":\"0\",\"3659\":\"0\",\"3687\":\"0\",\"3729\":\"1\",\"3744\":\"1\",\"3817\":\"0\",\"3845\":\"0\",\"3914\":\"0\",\"3950\":\"0\",\"4022\":\"0\",\"4122\":\"1\",\"4124\":\"0\",\"4184\":\"0\",\"4207\":\"0\",\"4208\":\"0\",\"4295\":\"0\",\"4328\":\"1\",\"4344\":\"0\",\"4403\":\"0\",\"4508\":\"1\",\"4531\":\"1\",\"4585\":\"1\",\"4677\":\"0\",\"4771\":\"1\",\"4774\":\"1\"},\"codebook\":{\"definition\":\"Credit-claiming occurs when a senator portrays themself, alone or with colleagues, as responsible for producing, securing, protecting, advancing, or delivering a concrete governmental benefit, policy outcome, funding award, program, or service.\",\"clarification\":\"Classify a release as credit-claiming when it explicitly connects the senator's actions—such as authoring or passing legislation, securing appropriations, obtaining an agency decision, intervening with an agency, or successfully advocating for a local project—to a realized or institutionally advanced outcome. This includes shared credit with a delegation or bipartisan group. A benefit need not be fully operational if the senator claims a clear achievement such as committee or chamber passage, an approved amendment, or an announced agency action attributable to their intervention.\",\"positive_examples\":[{\"text\":\"Sen. Talent \\\"worked with USDA officials to expedite the approval\\\" of Missouri's disaster request, and the release announces USDA's disaster declaration.\",\"explanation\":\"The senator explicitly links his work with federal officials to a concrete, approved benefit—disaster assistance eligibility for Missouri agricultural producers.\"},{\"text\":\"Sen. Dorgan states that he \\\"authored legislation, which was signed into law, that created\\\" Bismarck State College's National Center designation.\",\"explanation\":\"This directly claims responsibility for legislation that produced the designation benefiting an in-state institution.\"},{\"text\":\"Sen. DeWine says he \\\"wrote and passed the FIRE Act\\\" while announcing a firefighting grant to the Parma Fire Department under that program.\",\"explanation\":\"The release ties a local grant benefit to the senator's prior legislative accomplishment in creating and funding the grant program.\"}],\"negative_clarification\":\"Do not classify statements as credit-claiming when they merely express views, criticize opponents or agencies, announce an award without claiming a role in obtaining it, praise recipients, commemorate an event, or advocate for legislation or action that remains pending. Sponsorship, cosponsorship, a vote, or a request alone is not enough unless the release also presents a concrete successful outcome attributable to the senator.\",\"negative_examples\":[{\"text\":\"Sen. Kerry criticizes the Administration's handling of the Dubai Ports World deal and calls for improved port security.\",\"explanation\":\"This is criticism and policy positioning, not a claim that Kerry delivered a benefit or achieved a governmental outcome.\"},{\"text\":\"Sen. Allard invites constituents to a Greeley town meeting.\",\"explanation\":\"The release is an event announcement and contains no claim of securing policy, funding, or services.\"},{\"text\":\"Sen. Murkowski introduces legislation to permanently modify Alaska's Medicaid formula.\",\"explanation\":\"The senator is pursuing a proposal, but the release does not report that the proposed formula change or its benefits have been secured.\"}]}}",
