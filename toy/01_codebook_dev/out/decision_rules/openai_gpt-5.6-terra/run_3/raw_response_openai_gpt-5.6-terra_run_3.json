252\":\"1\",\"3271\":\"1\",\"3278\":\"1\",\"3328\":\"1\",\"3438\":\"0\",\"3477\":\"0\",\"3482\":\"1\",\"3501\":\"0\",\"3503\":\"0\",\"3534\":\"0\",\"3560\":\"0\",\"3577\":\"1\",\"3587\":\"1\",\"3625\":\"1\",\"3648\":\"1\",\"3659\":\"1\",\"3673\":\"1\",\"3675\":\"0\",\"3687\":\"0\",\"3729\":\"1\",\"3744\":\"1\",\"3746\":\"1\",\"3763\":\"1\",\"3806\":\"1\",\"3817\":\"0\",\"3824\":\"1\",\"3845\":\"1\",\"3891\":\"0\",\"3914\":\"0\",\"3950\":\"1\",\"3968\":\"1\",\"4022\":\"1\",\"4058\":\"0\",\"4096\":\"1\",\"4122\":\"1\",\"4124\":\"0\",\"4168\":\"1\",\"4184\":\"1\",\"4188\":\"1\",\"4207\":\"1\",\"4208\":\"1\",\"4232\":\"1\",\"4238\":\"0\",\"4293\":\"1\",\"4295\":\"1\",\"4328\":\"1\",\"4329\":\"1\",\"4344\":\"0\",\"4359\":\"1\",\"4403\":\"1\",\"4423\":\"1\",\"4424\":\"1\",\"4426\":\"0\",\"4508\":\"1\",\"4525\":\"1\",\"4531\":\"1\",\"4554\":\"0\",\"4580\":\"1\",\"4585\":\"1\",\"4662\":\"1\",\"4668\":\"1\",\"4677\":\"0\",\"4704\":\"1\",\"4771\":\"1\",\"4774\":\"1\",\"4778\":\"1\"},\"codebook\":{\"definition\":\"Credit-claiming occurs when a senator presents themself as having taken a meaningful action that produced, secured, advanced, protected, or directly helped obtain a policy, program, funding award, government decision, or other concrete benefit. Mere opinions, votes stated as positions, criticism, ceremonial remarks, and neutral announcements are not credit-claiming unless the text also attributes a substantive contribution to the senator.\",\"decision_rules\":[{\"rule_id\":\"1\",\"rule\":\"Classify as credit-claiming when the senator claims authorship, sponsorship, introduction, negotiation, amendment activity, or other legislative work that advanced or enacted a specified policy or bill.\",\"positive_example\":{\"text\":\"Sen. Byrd bolsters National Guard's Youth ChalleNGe: the Senate approved legislation by Sen. Robert C. Byrd to boost funding for the program.\",\"explanation\":\"The release directly attributes the legislative provision and its successful Senate approval to Byrd.\"},\"negative_example\":{\"text\":\"Sen. Jeffords comments on voting in support of Kerry and Levin amendments on Iraq.\",\"explanation\":\"The senator explains why he voted for amendments, but does not claim to have authored, secured, or advanced them.\"}},{\"rule_id\":\"2\",\"rule\":\"Classify as credit-claiming when the senator attributes the receipt, restoration, protection, or approval of specific federal funds, grants, projects, services, or government decisions to their own request, advocacy, appropriations work, or intervention.\",\"positive_example\":{\"text\":\"Sen. Kyl garners $3.4 million for Arizona high-tech training program: the Department of Labor granted his request for the training grant.\",\"explanation\":\"The text explicitly connects the awarded grant to Kyl's request.\"},\"negative_example\":{\"text\":\"Sens. Dodd and Lieberman announce a $2.25 million federal grant for Bradley International Airport.\",\"explanation\":\"The senators announce the grant, but the release does not claim that they secured it, requested it, or otherwise caused the award.\"}},{\"rule_id\":\"3\",\"rule\":\"Classify as credit-claiming when the senator presents advocacy, oversight, or direct engagement with an agency or other officials as instrumental in obtaining a response, advancing a constituent interest, or addressing a concrete problem.\",\"positive_example\":{\"text\":\"Administration agrees to Dorgan request to remove hold on North Dakota wind energy project.\",\"explanation\":\"The announcement explicitly credits Dorgan's request and advocacy with the Administration's decision to let the project proceed.\"},\"negative_example\":{\"text\":\"Sen. Cornyn asks Homeland Security chief to consider proposed Valley levee plans.\",\"explanation\":\"Cornyn requests consideration of a proposal, but the release reports no resulting decision or concrete achievement.\"}}]}}",
