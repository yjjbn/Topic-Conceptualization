252\":\"1\",\"3271\":\"1\",\"3278\":\"1\",\"3328\":\"1\",\"3438\":\"0\",\"3477\":\"0\",\"3482\":\"1\",\"3501\":\"0\",\"3503\":\"0\",\"3534\":\"0\",\"3560\":\"0\",\"3577\":\"1\",\"3587\":\"1\",\"3625\":\"1\",\"3648\":\"1\",\"3659\":\"0\",\"3673\":\"1\",\"3675\":\"0\",\"3687\":\"0\",\"3729\":\"1\",\"3744\":\"1\",\"3746\":\"1\",\"3763\":\"1\",\"3806\":\"1\",\"3817\":\"0\",\"3824\":\"1\",\"3845\":\"1\",\"3891\":\"0\",\"3914\":\"0\",\"3950\":\"1\",\"3968\":\"0\",\"4022\":\"1\",\"4058\":\"0\",\"4096\":\"1\",\"4122\":\"1\",\"4124\":\"0\",\"4168\":\"1\",\"4184\":\"1\",\"4188\":\"1\",\"4207\":\"1\",\"4208\":\"1\",\"4232\":\"1\",\"4238\":\"0\",\"4293\":\"0\",\"4295\":\"1\",\"4328\":\"1\",\"4329\":\"1\",\"4344\":\"0\",\"4359\":\"1\",\"4403\":\"1\",\"4423\":\"1\",\"4424\":\"1\",\"4426\":\"0\",\"4508\":\"1\",\"4525\":\"1\",\"4531\":\"1\",\"4554\":\"0\",\"4580\":\"1\",\"4585\":\"1\",\"4662\":\"1\",\"4668\":\"1\",\"4677\":\"0\",\"4704\":\"0\",\"4771\":\"1\",\"4774\":\"1\",\"4778\":\"1\"},\"codebook\":{\"definition\":\"Credit-claiming occurs when a senator presents themself, alone or with colleagues, as having caused, secured, created, advanced, protected, or materially contributed to a concrete governmental benefit, policy, program, funding outcome, or local/state result. It includes credit for legislative or oversight activity when the senator explicitly identifies their role, whether or not the effort has become law.\",\"decision_rules\":[{\"rule_id\":\"1\",\"rule\":\"Classify as credit-claiming when the senator explicitly takes credit for obtaining, securing, delivering, restoring, protecting, or otherwise helping produce a specific allocation, grant, designation, project, administrative decision, or other concrete benefit.\",\"positive_example\":{\"text\":\"Sen. Mikulski delivers on commitment to BRAC-related transportation projects and states that she fought to include funding for specified Maryland projects.\",\"explanation\":\"The release directly attributes concrete appropriations outcomes to the senator's own efforts.\"},\"negative_example\":{\"text\":\"Sens. Dodd and Lieberman announce that Bradley International Airport will receive a federal transportation grant.\",\"explanation\":\"The senators announce and praise an award, but the text does not say that they secured it, requested it, or otherwise caused the grant.\"}},{\"rule_id\":\"2\",\"rule\":\"Classify as credit-claiming when the senator claims authorship, sponsorship, introduction, successful amendment activity, or other identifiable leadership on legislation or a program, including a pending proposal.\",\"positive_example\":{\"text\":\"Sen. Dorgan says he authored legislation, signed into law, that created Bismarck State College's National Center designation.\",\"explanation\":\"The senator claims both authorship and a resulting enacted policy that generated the designation.\"},\"negative_example\":{\"text\":\"Sen. Nelson explains why he voted against Iraq withdrawal resolutions.\",\"explanation\":\"Casting and explaining a vote is a policy position, but it does not claim authorship, leadership, or credit for creating a policy accomplishment.\"}},{\"rule_id\":\"3\",\"rule\":\"Classify as credit-claiming when the senator claims to have used official intervention or oversight—such as letters, meetings, hearings, investigations, requests, or pressure—to advance or protect a specific constituency interest or government action.\",\"positive_example\":{\"text\":\"Sen. Santorum states that he wrote HUD urging support for Allentown's HOPE VI application and presents the resulting $20 million award.\",\"explanation\":\"The text connects the senator's specific intervention to a concrete local outcome.\"},\"negative_example\":{\"text\":\"Sen. Cornyn asks the Homeland Security Secretary to consider a local levee proposal.\",\"explanation\":\"The senator advocates for consideration of a proposal, but the release does not claim that the request produced an outcome.\"}}]}}",
