252\":\"1\",\"3271\":\"1\",\"3278\":\"1\",\"3328\":\"1\",\"3438\":\"0\",\"3477\":\"1\",\"3482\":\"1\",\"3501\":\"0\",\"3503\":\"0\",\"3534\":\"0\",\"3560\":\"0\",\"3577\":\"1\",\"3587\":\"1\",\"3625\":\"1\",\"3648\":\"1\",\"3659\":\"1\",\"3673\":\"1\",\"3675\":\"0\",\"3687\":\"0\",\"3729\":\"1\",\"3744\":\"0\",\"3746\":\"1\",\"3763\":\"1\",\"3806\":\"1\",\"3817\":\"0\",\"3824\":\"1\",\"3845\":\"1\",\"3891\":\"1\",\"3914\":\"0\",\"3950\":\"1\",\"3968\":\"1\",\"4022\":\"1\",\"4058\":\"0\",\"4096\":\"1\",\"4122\":\"1\",\"4124\":\"0\",\"4168\":\"0\",\"4184\":\"1\",\"4188\":\"0\",\"4207\":\"1\",\"4208\":\"1\",\"4232\":\"1\",\"4238\":\"0\",\"4293\":\"0\",\"4295\":\"1\",\"4328\":\"1\",\"4329\":\"0\",\"4344\":\"0\",\"4359\":\"1\",\"4403\":\"1\",\"4423\":\"1\",\"4424\":\"1\",\"4426\":\"0\",\"4508\":\"1\",\"4525\":\"1\",\"4531\":\"1\",\"4554\":\"0\",\"4580\":\"1\",\"4585\":\"1\",\"4662\":\"0\",\"4668\":\"1\",\"4677\":\"0\",\"4704\":\"0\",\"4771\":\"1\",\"4774\":\"1\",\"4778\":\"1\"},\"codebook\":{\"definition\":\"Credit-claiming occurs when a senator presents themself as responsible for, instrumental in obtaining, or actively advancing a governmental benefit, policy, program, funding outcome, or legislative action. It includes claims of securing or delivering concrete results and claims of authorship, sponsorship, or other leadership in advancing legislation. Mere policy opinions, criticism, ceremonial statements, announcements without a claimed senatorial role, and requests that have not produced an attributed result are not credit-claiming.\",\"decision_rules\":[{\"rule_id\":\"1\",\"rule\":\"Classify as credit-claiming when the senator attributes a concrete governmental outcome, funding award, program, designation, or other benefit to their own efforts, such as securing funds, obtaining agency action, delivering a project, or successfully intervening on behalf of constituents.\",\"positive_example\":{\"text\":\"“Sen. Talent ... worked with USDA officials to expedite the approval of the Governor's request” for Missouri's disaster designation.\",\"explanation\":\"The release explicitly connects Talent's work to a completed federal disaster designation and the resulting assistance for Missouri producers.\"},\"negative_example\":{\"text\":\"“Bradley International Airport will receive a federal grant totaling $2,250,000” from the Department of Transportation.\",\"explanation\":\"Although senators announce a concrete grant, the release does not say they secured it, requested it, or otherwise caused the award.\"}},{\"rule_id\":\"2\",\"rule\":\"Classify as credit-claiming when the senator claims a leading legislative role, including introducing, authoring, sponsoring, securing passage of, or successfully adding a provision or amendment to legislation, even if final enactment or implementation remains pending.\",\"positive_example\":{\"text\":\"“Dorgan authored legislation, which was signed into law, that created the National Center designation.”\",\"explanation\":\"The senator explicitly claims authorship of the law that produced the designation.\"},\"negative_example\":{\"text\":\"“Sen. Jeffords ... voted in support of the Sens. Kerry and Levin amendments today.”\",\"explanation\":\"A statement explaining a vote and policy position does not claim authorship, sponsorship, leadership, or responsibility for advancing the amendments.\"}}]}}",
