clean_feature <- function(feat_col) {
x <- feat_col %>%
str_to_lower() %>%
SnowballC::wordStem()
case_when(
x %in% c("gwa", "gwass") ~ "gwas",
x %in% c("latino", "latinx", "latina") ~ "latino",
x %in% c("minor", "minorit") ~ "minorit",
x %in% c("resequ", "resequenc") ~ "resequenc",
x %in% c("underrepres", "underrepresent") ~ "underrepresent",
x %in% c("young", "younger") ~ "young",
x %in% c("ukb", "ukbb") ~ "ukb",
x %in% c("amongst", "among") ~ "among",
x %in% c("admix", "admixtur") ~ "admixture",
TRUE ~ x
)
}
process_nns <- function(nns_df) {
df <- nns_df %>%
filter(!str_detect(feature, '\\d'),
!str_detect(feature,
regex('ancestr|ethnic|racial|race', ignore_case=TRUE))) %>%
mutate(feature_clean = clean_feature(feature)) %>%
mutate(population = feature_clean %in% populations)
return(df)
}
