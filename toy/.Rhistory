"!genetics_article_major"
),
term = c("TERM_ETHNIC", "TERM_RACE", "TERM_ANCESTRY"),
# corpus = c("orig", "nopop", "norea", "nopoprea"),
journal_reg = c("eur", "eap")
)
params_df <- crossing(
gen = c(
"genetics_article_major",
"!genetics_article_major"
),
term = c("TERM_ETHNIC", "TERM_RACE", "TERM_ANCESTRY"),
# corpus = c("orig", "nopop", "norea", "nopoprea"),
journal_reg = c("eur", "eap")
)
journal_eap_eur_conText <- pmap(params_df, function(gen, term, journal_reg) {
message(gen, term, journal_reg)
t <- tokens_subset(pubmed_REA_toks,
year %in% 2020:2030 &
eval(parse(text = gen)))
docvars(t, "journal_region") <- docvars(t, "journal_region") == journal_reg
docvars(t, "journal_region") <- factor(docvars(t, "journal_region"))
fml <- as.formula(paste0(term, " ~ journal_region"))
mod <- conText(formula=fml,
data=t,
pre_trained=glove,
transform=TRUE,
transform_matrix=A_mat_500,
jackknife=FALSE,
permute=FALSE,
parallel=FALSE,
window=10,
cluster_variable="article_id")
mod@normed_coefficients$term <- term
mod@normed_coefficients$gen <- gen
mod@normed_coefficients$reg <- journal_reg
mod
})
terms_consol <- read.csv("~/GenREA-replication/02_prep_datasets/term_tagging/terms_consol.csv")
load("~/gen_temp/pubmed_REA_toks.RData")
