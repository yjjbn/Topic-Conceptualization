terms_consol <- terms_consol %>%
left_join(full_vocab, by=join_by(tok=term))
fullvocab <- readRDS("~/gen_temp/fullvocab.rds")
terms_consol <- terms_consol %>%
left_join(fullvocab, by=join_by(tok=term))
terms_consol <- terms_consol %>%
left_join(fullvocab, by=join_by(tok==term))
View(terms_consol)
