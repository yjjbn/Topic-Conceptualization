# one row per article, only labelled articles
countries_df_articlelevel <- countries_df %>%
distinct(article_id, .keep_all = TRUE) %>% # count each article only once
filter(!unlabeled)
# pass to tokens
article_meta <- countries_df_articlelevel %>%
select(article_id, unlabeled, num_counted, n_us_percent:n_unk_percent, maj, single_region)
docvars(pubmed_REA_toks) <- docvars(pubmed_REA_toks) %>%
left_join(article_meta, by="article_id")
pubmed_REA_toks_geo <- tokens_subset(pubmed_REA_toks, !unlabeled)
params_df <- crossing(
gen = c(
# "genetics_broadsubject",
# "!genetics_broadsubject",
# "genetics_article_mesh_sh",
# "!genetics_article_mesh_sh"
"genetics_article_major",
"!genetics_article_major"
),
term = c("TERM_ETHNIC", "TERM_RACE", "TERM_ANCESTRY")
)
term_context_USmaj <- pmap(params_df, function(gen, term) {
message(term, gen)
t <- tokens_subset(pubmed_REA_toks_geo,
year %in% 2020:2030 &
eval(parse(text = gen)))
docvars(t, "maj_us") <- docvars(t, "maj")=="n_us_percent"
docvars(t, "maj_us") <- factor(docvars(t, "maj_us"))
fml <- as.formula(paste0(term, " ~ maj_us"))
mod <- conText(formula=fml,
data=t,
pre_trained=glove,
transform=TRUE,
transform_matrix=A_mat_500,
jackknife=FALSE,
permute=FALSE,
parallel=FALSE,
window=10,
cluster_variable="article_id")
mod
})
