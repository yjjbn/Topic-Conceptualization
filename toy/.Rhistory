params_df <- crossing(
gen = c(
"genetics_article_major",
"!genetics_article_major"
),
term = c("TERM_ETHNIC", "TERM_RACE", "TERM_ANCESTRY"),
corpus = c("orig", "nopop", "norea", "nopoprea")
)
term_context_USmaj <- pmap(params_df, function(gen, term, corpus) {
message(term, gen, corpus)
t <- tokens_subset(pubmed_REA_toks_geo,
year %in% 2020:2030 &
eval(parse(text = gen)))
docvars(t, "maj_us") <- docvars(t, "maj")=="n_us_percent"
docvars(t, "maj_us") <- factor(docvars(t, "maj_us"))
if (corpus=="nopop") {
t <- tokens_remove(t,
pattern=c(popcats),
valuetype="fixed",
padding=TRUE,
verbose=TRUE)
} else if (corpus=="norea") {
t <- tokens_remove(t,
pattern=c(race_feats, ethn_feats, ance_feats),
valuetype="fixed",
padding=TRUE,
verbose=TRUE)
} else if (corpus=="nopoprea") {
t <- tokens_remove(t,
pattern=c(popcats, race_feats, ethn_feats, ance_feats),
valuetype="fixed",
padding=TRUE,
verbose=TRUE)
}
fml <- as.formula(paste0(term, " ~ maj_us"))
mod <- conText(formula=fml,
data=t,
pre_trained=glove,
transform=TRUE,
transform_matrix=A_mat_500,
jackknife=FALSE,
permute=FALSE,
parallel=FALSE,
window=10,
cluster_variable="article_id")
mod@normed_coefficients$corpus <- corpus
mod@normed_coefficients$term <- term
mod@normed_coefficients$gen <- gen
mod
})
ggplot(aes(x=term, y=normed.estimate.deflated, color=corpus)) +
geom_point() +
facet_wrap(~gen)
map(c(term_context_USmaj), function(x) {
x@normed_coefficients
}) %>% list_rbind() %>%
ggplot(aes(x=term, y=normed.estimate.deflated, color=corpus)) +
geom_point() +
facet_wrap(~gen)
