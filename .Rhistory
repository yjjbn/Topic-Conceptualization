load("pubmed_control_sample_tok.RData")
control_dv <- docvars(pubmed_control_sample_tok) %>%
mutate(n_eur = rowSums(across(c(n_eur, n_nam, n_au)), na.rm = FALSE)) %>%
select(-n_nam, -n_au) %>%
mutate(num_counted = rowSums(across(n_us:n_unk), na.rm = FALSE),
unlabeled = num_counted == 0 | is.na(num_counted), # 132 unlabelled
across(c(n_us:n_unk), ~.x/num_counted,
.names = "{.col}_percent")) %>%
mutate( # Assign region with majority of authors, like 40/30/30 --> 40
perc = select(., n_us_percent:n_unk_percent),
maj  = names(perc)[max.col(perc)],
tie  = rowSums(perc == do.call(pmax, perc)) > 1,
maj  = ifelse(tie, "tie", maj) # 2538/182775 ties
) %>%
select(-perc) %>%
mutate(
cols = pick(n_us_percent:n_unk_percent),
num_regions = rowSums(cols > 0, na.rm = FALSE),
single_region = if_else(
num_regions == 1,
names(cols)[max.col(cols)],
"multi"
)
) %>%
select(-cols)
# pass to tokens
docvars(pubmed_control_sample_tok) <- docvars(pubmed_control_sample_tok) %>%
left_join(control_dv, by="pmid")
pubmed_control_sample_tok_geo <- tokens_subset(pubmed_control_sample_tok, !unlabeled)
