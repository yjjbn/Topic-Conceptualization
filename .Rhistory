term_context_USmaj_nopop <- pmap(params_df, function(gen, term) {
message(term, gen)
t <- tokens_subset(pubmed_REA_toks_geo,
year %in% 2020:2030 &
eval(parse(text = gen)))
t <- tokens_remove(t,
pattern=c(popcats),
valuetype="fixed",
padding=TRUE,
verbose=TRUE)
docvars(t, "maj_us") <- docvars(t, "maj")=="n_us_percent"
docvars(t, "maj_us") <- factor(docvars(t, "maj_us"))
fml <- as.formula(paste0(term, " ~ maj_us"))
mod <- conText(formula=fml,
data=t,
pre_trained=glove,
transform=TRUE,
transform_matrix=A_mat_500,
jackknife=FALSE,
permute=FALSE,
parallel=FALSE,
window=10,
cluster_variable="article_id")
mod@normed_coefficients$descriptor <- "nopop"
mod
})
